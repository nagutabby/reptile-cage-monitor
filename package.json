    "@aws-sdk/client-iot-data-plane": "^3.1146.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@hono/aws-lambda": "^1.0.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "aws-cdk": "2.1144.0",
