# M5Stack/Streamlitと共有するAPIキー(任意の文字列。両者で同じ値にする)
API_KEY=
IOT_INGEST_KEY=

# Cloudflare D1 (REST API経由でアクセス。Workersバインディングは使わない)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# LINE Messaging API (LINE Notifyは2025年3月に終了しているため使用不可)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_ID=

# 異常が続いている間の再通知間隔(秒)
ALERT_RESEND_INTERVAL_SEC=3600
