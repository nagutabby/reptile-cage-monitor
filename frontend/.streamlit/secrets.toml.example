# このファイルを secrets.toml にコピーしてローカル値を入力するか、
# Streamlit Community Cloud の Settings > Secrets に同じ内容をTOMLとして貼り付ける。
# secrets.toml (実ファイル) は .gitignore 対象。
FASTAPI_URL = "https://your-backend.onrender.com"
API_KEY = "your-api-key" # backend/.env の API_KEY と同じ値にする
LIGHT_CONTROL_URL = "https://your-api-id.execute-api.ap-northeast-1.amazonaws.com/control/light"
# MQTT 閲覧用の Cognito Identity Pool ID と IoT endpoint は公開情報としてアプリに設定済み。

# Cognito User Pool OIDC. Redirect URI must end in /oauth2callback.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
expose_tokens = "id"

[auth.cognito]
client_id = "your-user-pool-app-client-id"
client_secret = "your-user-pool-app-client-secret"
server_metadata_url = "https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_XXXX/.well-known/openid-configuration"
